{
 "_doc": "Every threshold the edit uses. Copy to my-config.json and pass --config, or drop a config.json inside an inbox folder (deep-merged over this file). Paths starting with ~ are expanded.",
 "paths": {
  "inbox": "~/longform/inbox",
  "outbox": "~/longform/out",
  "whisper_bin": "whisper-cli",
  "whisper_model": "~/models/whisper/ggml-small.en.bin",
  "ffmpeg": "ffmpeg",
  "ffprobe": "ffprobe"
 },
 "ingest": {
  "sync_search_s": 30.0,
  "sync_window_s": 120.0,
  "sync_min_confidence": 4.0,
  "camera_name_regex": "(camera|webcam|^dji_|^gopr|^img_)"
 },
 "transcribe": {
  "_doc": "prompt: a short disfluent sentence keeps whisper writing um/uh and false starts (needed for retake detection); add your own names and product words at the end.",
  "prompt": "Umm, let me think like, hmm... Okay, here's what I'm, like, thinking. So, uh, I- I mean, you know. Claude Code, GitHub, repo.",
  "threads": 6,
  "beam_size": 5,
  "extra_args": []
 },
 "audio_detect": {
  "hop_ms": 10,
  "floor_percentile": 5,
  "quiet_above_floor_db": 12.0,
  "quiet_max_db": -40.0,
  "breath_above_floor_db": 5.0
 },
 "retakes": {
  "enabled": true,
  "phrase_gap_s": 0.45,
  "window_s": 45.0,
  "max_span_s": 30.0,
  "restart_min_prefix_words": 2,
  "restart_similarity": 0.8,
  "flag_similarity": 0.55,
  "cue_phrases": [
   "let me say that again",
   "let me say it again",
   "let me redo that",
   "let me redo",
   "let me do that again",
   "let me try that again",
   "let me try again",
   "let me start again",
   "let me start over",
   "start over",
   "let me rephrase",
   "let me rephrase that",
   "scratch that",
   "take two",
   "retake",
   "one more time",
   "i'll say that again",
   "i'll redo that",
   "sorry let me",
   "cut that",
   "redo that",
   "from the top"
  ],
  "stutter_whitelist": [
   "that",
   "had",
   "very",
   "no",
   "bye",
   "really",
   "yeah",
   "so",
   "okay",
   "ha"
  ],
  "remove_fillers": true,
  "fillers": [
   "um",
   "uh",
   "umm",
   "uhh",
   "erm",
   "uhm",
   "ah",
   "hmm",
   "mm"
  ]
 },
 "deadspace": {
  "min_silence_s": 0.7,
  "min_cut_s": 0.25,
  "handle_after_word_s": 0.16,
  "handle_before_word_s": 0.12,
  "gap_mid_sentence_s": 0.28,
  "gap_sentence_end_s": 0.4,
  "max_breath_preroll_s": 0.35,
  "head_keep_s": 0.3,
  "tail_keep_s": 1.0,
  "cursor_only_gap_s": 0.6,
  "screen_analysis_fps": 8,
  "screen_analysis_width": 480,
  "pixel_diff_threshold": 14,
  "cursor_blob_max_frac": 0.004,
  "text_line_aspect": 3.0,
  "active_sample_frac": 0.0015,
  "active_min_s": 0.35,
  "net_change_frac": 0.003,
  "camera_mask_persist_frac": 0.3,
  "camera_kind_mask_frac": 0.45,
  "action_pre_pad_s": 0.3,
  "result_hold_s": 0.9,
  "speedup_min_s": 4.5,
  "speedup_target_s": 4.0,
  "speedup_min_factor": 1.5,
  "speedup_max_factor": 3.0,
  "speedup_step": 0.5,
  "kind": "auto"
 },
 "render": {
  "fps": "auto",
  "encoder": "x264",
  "_encoder_doc": "x264 (portable, deterministic) or videotoolbox (macOS hardware, faster)",
  "x264_crf": 17,
  "x264_preset": "faster",
  "bitrate_1080": "14M",
  "bitrate_1440": "22M",
  "bitrate_2160": "45M",
  "chunk_source_s": 150.0,
  "parallel": 2,
  "xfade_ms": 15,
  "zero_cross_ms": 3,
  "audio_codec": "aac",
  "audio_bitrate": "320k"
 },
 "master": {
  "highpass_hz": 75,
  "denoise": "afftdn",
  "denoise_nr_db": 10,
  "deesser_intensity": 0.35,
  "mud_cut_hz": 220,
  "mud_cut_db": -2.0,
  "presence_hz": 4000,
  "presence_db": 2.0,
  "air_db": 1.5,
  "comp_threshold_db": -21,
  "comp_ratio": 2.5,
  "comp_attack_ms": 12,
  "comp_release_ms": 160,
  "target_lufs": -14.0,
  "target_tp_db": -1.5,
  "limiter_db": -2.0
 },
 "gates": {
  "word_recall_min": 0.93,
  "missing_run_fail_words": 6,
  "av_probe_points": 10,
  "av_audio_lag_max_ms": 25,
  "caption_median_max_s": 0.12,
  "caption_p95_max_s": 0.25,
  "loudness_tolerance_lu": 1.0,
  "tp_max_db": -1.0,
  "captions_coverage_min": 0.98
 },
 "publish": {
  "channel_context": "a YouTube creator who teaches practical AI tools",
  "cta_line": "",
  "cta_keywords": [],
  "word_fixes": {
   "_doc": "whisper mishearings fixed in the FINAL words (SRT + chapters)",
   "cloud code": "Claude Code"
  },
  "chapter_min_s": 40,
  "chapter_target_s": 90,
  "chapter_max": 14,
  "use_claude_cli": true,
  "claude_timeout_s": 240,
  "caption_max_chars": 42,
  "caption_max_words": 8,
  "caption_max_s": 4.5,
  "contact_cols": 6,
  "contact_rows": 5,
  "burn_captions": false,
  "burn_max_words": 5,
  "burn_style": "FontName=Inter,FontSize=16,Bold=1,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=1,Outline=2,Shadow=0,MarginV=40"
 }
}